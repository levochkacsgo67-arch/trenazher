{"id": "t1s1", "name": "Сложение дробей", "theory": "Чтобы сложить дроби с разными знаменателями, приведите их к общему знаменателю, затем сложите числители. Пример: 1/2 + 1/3 = 3/6 + 2/6 = 5/6.", "tasks": [{"type": "choice", "q": "Вычислите: 1 + 2", "options": ["7/2", "1", "3/2", "3"], "a": ["3"], "id": "t1s1-1"}, {"type": "choice", "q": "Вычислите: 3/2 + 5/3", "options": ["8/5", "11/3", "1/6", "19/6"], "a": ["19/6"], "id": "t1s1-2"}, {"type": "choice", "q": "Вычислите: 2 + 1", "options": ["7/2", "3/2", "3", "1"], "a": ["3"], "id": "t1s1-3"}, {"type": "choice", "q": "Вычислите: 1 + 5/6", "options": ["7/3", "6/7", "1/6", "11/6"], "a": ["11/6"], "id": "t1s1-4"}, {"type": "choice", "q": "Вычислите: 5/3 + 1/2", "options": ["7/6", "13/6", "6/5", "8/3"], "a": ["13/6"], "id": "t1s1-5"}, {"type": "choice", "q": "Вычислите: 5/4 + 5/3", "options": ["41/12", "5/12", "10/7", "35/12"], "a": ["35/12"], "id": "t1s1-6"}, {"type": "choice", "q": "Вычислите: 3/2 + 5/2", "options": ["9/2", "1", "8/4", "4"], "a": ["4"], "id": "t1s1-7"}, {"type": "choice", "q": "Вычислите: 2/3 + 1/2", "options": ["7/6", "3/5", "5/3", "1/6"], "a": ["7/6"], "id": "t1s1-8"}, {"type": "choice", "q": "Вычислите: 2/3 + 1", "options": ["5/3", "13/6", "1/3", "3/4"], "a": ["5/3"], "id": "t1s1-9"}, {"type": "choice", "q": "Вычислите: 1/2 + 3/2", "options": ["1", "5/2", "4/4", "2"], "a": ["2"], "id": "t1s1-10"}, {"type": "choice", "q": "Вычислите: 1/2 + 1/3", "options": ["4/3", "2/5", "5/6", "1/6"], "a": ["5/6"], "id": "t1s1-11"}, {"type": "choice", "q": "Вычислите: 5/4 + 3/4", "options": ["2", "5/2", "8/8", "1/2"], "a": ["2"], "id": "t1s1-12"}]}