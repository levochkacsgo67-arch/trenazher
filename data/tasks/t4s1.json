{"id": "t4s1", "name": "Линейные неравенства", "theory": "Неравенство решают как уравнение, но при делении на отрицательное число знак меняется на противоположный.", "tasks": [{"type": "choice", "q": "Решите неравенство: 2x + 2 > -6", "options": ["x < -4", "x > -4", "x ≥ -4", "x > 4"], "a": ["x > -4"], "id": "t4s1-1"}, {"type": "choice", "q": "Решите неравенство: 4x + 4 > -16", "options": ["x > 5", "x ≥ -5", "x > -5", "x < -5"], "a": ["x > -5"], "id": "t4s1-2"}, {"type": "choice", "q": "Решите неравенство: 5x − 2 > -27", "options": ["x > -5", "x ≥ -5", "x < -5", "x > 5"], "a": ["x > -5"], "id": "t4s1-3"}, {"type": "choice", "q": "Решите неравенство: 3x − 1 > -16", "options": ["x > 5", "x > -5", "x ≥ -5", "x < -5"], "a": ["x > -5"], "id": "t4s1-4"}, {"type": "choice", "q": "Решите неравенство: 2x + 2 > 2", "options": ["x ≥ 0", "x < 0", "x > 0"], "a": ["x > 0"], "id": "t4s1-5"}, {"type": "choice", "q": "Решите неравенство: 4x + 10 > 22", "options": ["x ≥ 3", "x > -3", "x > 3", "x < 3"], "a": ["x > 3"], "id": "t4s1-6"}, {"type": "choice", "q": "Решите неравенство: 2x − 8 > -10", "options": ["x > 1", "x > -1", "x ≥ -1", "x < -1"], "a": ["x > -1"], "id": "t4s1-7"}, {"type": "choice", "q": "Решите неравенство: 5x − 1 > -26", "options": ["x < -5", "x > -5", "x ≥ -5", "x > 5"], "a": ["x > -5"], "id": "t4s1-8"}, {"type": "choice", "q": "Решите неравенство: 2x + 6 > 14", "options": ["x > 4", "x ≥ 4", "x > -4", "x < 4"], "a": ["x > 4"], "id": "t4s1-9"}, {"type": "choice", "q": "Решите неравенство: 4x − 6 > 2", "options": ["x < 2", "x > 2", "x ≥ 2", "x > -2"], "a": ["x > 2"], "id": "t4s1-10"}, {"type": "choice", "q": "Решите неравенство: 2x + 10 > 16", "options": ["x < 3", "x > 3", "x > -3", "x ≥ 3"], "a": ["x > 3"], "id": "t4s1-11"}, {"type": "choice", "q": "Решите неравенство: 6x + 8 > 26", "options": ["x < 3", "x ≥ 3", "x > -3", "x > 3"], "a": ["x > 3"], "id": "t4s1-12"}]}