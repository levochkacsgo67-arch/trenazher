{"id": "t3s1", "name": "Линейные уравнения", "theory": "Уравнение вида ax + b = c решают так: переносят b в правую часть и делят на a. x = (c − b) / a.", "tasks": [{"type": "input", "q": "Решите уравнение: 8x + 8 = -40", "a": ["-6"], "id": "t3s1-1"}, {"type": "input", "q": "Решите уравнение: 3x − 5 = -2", "a": ["1"], "id": "t3s1-2"}, {"type": "input", "q": "Решите уравнение: 3x − 7 = 5", "a": ["4"], "id": "t3s1-3"}, {"type": "input", "q": "Решите уравнение: 3x − 11 = -11", "a": ["0"], "id": "t3s1-4"}, {"type": "input", "q": "Решите уравнение: 4x − 4 = 4", "a": ["2"], "id": "t3s1-5"}, {"type": "input", "q": "Решите уравнение: 9x − 6 = -51", "a": ["-5"], "id": "t3s1-6"}, {"type": "input", "q": "Решите уравнение: 8x + 11 = -37", "a": ["-6"], "id": "t3s1-7"}, {"type": "input", "q": "Решите уравнение: 5x − 10 = -30", "a": ["-4"], "id": "t3s1-8"}, {"type": "input", "q": "Решите уравнение: 8x + 1 = 33", "a": ["4"], "id": "t3s1-9"}, {"type": "input", "q": "Решите уравнение: 5x + 2 = 22", "a": ["4"], "id": "t3s1-10"}, {"type": "input", "q": "Решите уравнение: 3x + 3 = 6", "a": ["1"], "id": "t3s1-11"}, {"type": "input", "q": "Решите уравнение: 7x + 15 = -48", "a": ["-9"], "id": "t3s1-12"}]}