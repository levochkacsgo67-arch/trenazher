{"id": "t1s3", "name": "Проценты от числа", "theory": "Процент - это сотая часть числа. Чтобы найти p% от числа n, нужно n · p / 100. Пример: 20% от 150 = 150 · 20 / 100 = 30.", "tasks": [{"type": "input", "q": "Найдите 15% от числа 120.", "a": ["18"], "id": "t1s3-1"}, {"type": "input", "q": "Найдите 20% от числа 40.", "a": ["8"], "id": "t1s3-2"}, {"type": "input", "q": "Найдите 50% от числа 80.", "a": ["40"], "id": "t1s3-3"}, {"type": "input", "q": "Найдите 25% от числа 200.", "a": ["50"], "id": "t1s3-4"}, {"type": "input", "q": "Найдите 5% от числа 80.", "a": ["4"], "id": "t1s3-5"}, {"type": "input", "q": "Найдите 40% от числа 240.", "a": ["96"], "id": "t1s3-6"}, {"type": "input", "q": "Найдите 30% от числа 80.", "a": ["24"], "id": "t1s3-7"}, {"type": "input", "q": "Найдите 75% от числа 40.", "a": ["30"], "id": "t1s3-8"}, {"type": "input", "q": "Найдите 50% от числа 400.", "a": ["200"], "id": "t1s3-9"}, {"type": "input", "q": "Найдите 40% от числа 400.", "a": ["160"], "id": "t1s3-10"}, {"type": "input", "q": "Найдите 40% от числа 60.", "a": ["24"], "id": "t1s3-11"}, {"type": "input", "q": "Найдите 5% от числа 120.", "a": ["6"], "id": "t1s3-12"}]}